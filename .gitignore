# ==========================================
# ChuPetLove - Global .gitignore
# ==========================================

# Ambientes virtuales de Python
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / Python Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Bases de datos locales SQLite y binarios temporales
*.db
*.sqlite
*.sqlite3
chupetlove_db.db

# Variables de entorno y secretos
.env
.env.local
.env.*.local
backend/.env
!.env.example
!backend/.env.example

# Archivos de subida de usuarios (comprobantes de pago)
backend/uploads/payment_proofs/*
!backend/uploads/payment_proofs/.gitkeep

# Pruebas y cobertura
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Dependencias y compilación de Node / React
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editores y configuraciones del IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Herramientas de agentes IA (Gemini / Antigravity)
.gemini/
.agents/
